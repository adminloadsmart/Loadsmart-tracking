NODE_ENV=development

# Which process roles to run: 'all' (local dev) or a comma list of
# scheduler, processor, poller, realtime, api — see docs/ROADMAP.md §1.
ROLE=all

# REST API (api role), socket.io (realtime role), /healthz /readyz /metrics (every process).
PORT=4100
REALTIME_PORT=4101
OPS_PORT=9100

CORS_ORIGINS=http://localhost:3000

# docker/docker-compose.yml (TimescaleDB + PostGIS) — offset ports so the main loadsmart backend's
# Postgres/Redis can run alongside. The service also runs on plain PostgreSQL, e.g. sharing the
# main loadsmart database during development (no TimescaleDB/PostGIS: plain tables + a retention
# job). Its migration history lives in its own table (tracking_migrations).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tracking
REDIS_URL=redis://localhost:6380
# The main loadsmart backend's Redis — source of the loadsmart.events snapshot stream
# (docs/contracts/loadsmart-events.md). Defaults to REDIS_URL so the service runs standalone.
MAIN_REDIS_URL=

# Point stream: partitions are fixed for the life of the stream (docs/ROADMAP.md §7).
POINT_PARTITIONS=16
POINT_STREAM_MAXLEN=1500000
STREAM_MAX_DELIVERIES=5

# Phone GPS (docs/contracts/driver-socket.md).
PHONE_MAX_ACCURACY_M=50
PHONE_MIN_INTERVAL_MS=4000

# auto (use TimescaleDB/PostGIS when installed) | none (always plain PostgreSQL)
TRACKING_DB_EXTENSIONS=auto

LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000
LEADER_LOCK_TTL_MS=15000

# OpenTelemetry tracing — leave unset to disable (e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=loadsmart-tracking

# Google Routes + Geocoding APIs: planned routes for the DELAY / DEV rules. Leave empty to
# disable route planning (trips show route_status=no_api_key).
GOOGLE_MAPS_API_KEY=

# Roadcast GPS devices (vehicles with a gps_device_imei in main). One call per org every
# ROADCAST_POLL_INTERVAL_MS with the IMEIs of its trucks on a trip, and every
# ROADCAST_IDLE_INTERVAL_MS with all its IMEIs (idle trucks get one point per that interval).
# Leave the key empty to keep the poller off.
ROADCAST_API_URL=https://example.net/api/v2/rest/integrations/pull-positions-api
ROADCAST_API_KEY=
ROADCAST_POLL_INTERVAL_MS=10000
ROADCAST_IDLE_INTERVAL_MS=300000
ROADCAST_TIMEOUT_MS=8000
# Unit of Roadcast's `speed` field: kmh | knots (unconfirmed).
ROADCAST_SPEED_UNIT=kmh

# Same secret as the main loadsmart backend (verifies its driver JWTs). Required by the realtime role.
JWT_SECRET=dev-only-shared-secret-change-me-0123456789

# Raw-payload archive (S3 / S3-compatible). Needed from Phase 1.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
